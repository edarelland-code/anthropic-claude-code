{
  "name": "contextshelf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "supabase db push",
    "db:push:hosted": "node scripts/migrate-hosted.mjs",
    "db:types": "supabase gen types typescript --linked > src/lib/adapters/supabase/database.types.ts",
    "test:db": "bash scripts/db-test.sh",
    "test:responsive": "node scripts/responsive-qa.mjs",
    "provision": "node scripts/provision.mjs",
    "validate:hosted": "node scripts/validate-hosted.mjs",
    "schema:parity": "node scripts/schema-parity.mjs",
    "verify:hosted": "node scripts/verify-hosted.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.45.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.451.0",
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.8.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
