# ContextShelf environment
# Copy to .env.local and fill in from your Supabase project settings (API section).
# .env.local is gitignored. Never commit real values.

# --- Required: Supabase (source of truth) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Required for the /api/ingest server route (Phase 5) ---
# Server-only. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Where the app is reachable (auth redirects, ingest hook target) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
