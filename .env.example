# ContextShelf environment
# Copy to .env.local and fill in from your Supabase project settings (API Keys).
# .env.local is gitignored. Never commit real values.

# --- Required: Supabase (source of truth) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The publishable key (starts with sb_publishable_). This is Supabase's current
# browser-facing key and replaces the legacy anon JWT. It is meant to be public:
# row-level security is what protects the data, not the secrecy of this value.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# --- Required for the /api/ingest server route (Phase 5) ---
# The secret key (starts with sb_secret_), the counterpart to the publishable
# key. It bypasses row-level security entirely, so it is server-only and must
# NEVER be given a NEXT_PUBLIC_ prefix. Not used yet.
SUPABASE_SECRET_KEY=sb_secret_your-key

# --- Where the app is reachable (auth redirects, ingest hook target) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
